# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
PIXABAY_API_KEY=
# Optional: Unsplash photos for mood and scenery shots. Create an app at https://unsplash.com/oauth/applications
# and paste its Access Key (not the Secret Key).
UNSPLASH_ACCESS_KEY=
# Optional, free: Gemini checks photos and matches your uploads when the Claude API isn't used.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: port the worker uses to serve /data to the Remotion renderer
# ASSET_PORT=3939
